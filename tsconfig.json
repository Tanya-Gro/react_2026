{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "incremental": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "noUncheckedSideEffectImports": true,
    "strictPropertyInitialization": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "components": [
        "./src/components/index.ts"
      ],
      "components/*": [
        "./src/components/*"
      ],
      "routes": [
        "./src/routes/index.tsx"
      ],
      "app": [
        "./src/app/index.ts"
      ],
      "app/*": [
        "./src/app/*"
      ],
      "mocks": [
        "./src/mocks/index.ts"
      ],
      "helpers": [
        "./src/helpers/index.ts"
      ],
      "hooks": [
        "./src/hooks/index.ts"
      ],
      "features": [
        "./src/features/index.ts"
      ],
      "context": [
        "./src/context/index.ts"
      ],
      "layouts": [
        "./src/layouts/index.ts"
      ],
      "services": [
        "./src/services/index.ts"
      ],
      "app/constants": [
        "./src/app/constants.ts"
      ],
      "i18n/*": [
        "./src/i18n/*"
      ],
      "lib/*": [
        "./src/lib/*"
      ],
      "src/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "./src",
    "./dist/types/**/*.ts",
    "./next-env.d.ts",
    "dist/types/**/*.ts",
    "dist/dev/types/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "./node_modules"
  ]
}
